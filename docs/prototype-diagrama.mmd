classDiagram
    class Prototype~T~ {
        <<interface>>
        +clonar() T
    }
    class Pedido {
        -contador$ long
        -id long
        -cliente String
        -enderecoEntrega String
        -itens List~ItemPedido~
        -criadoEm LocalDate
        +clonar() Pedido
        +clonarPorSerializacao() Pedido
        +adicionarItem(ItemPedido)
        +valorTotal() BigDecimal
    }
    class ItemPedido {
        -produto String
        -quantidade int
        -precoUnitario BigDecimal
        +ItemPedido(ItemPedido)
        +subtotal() BigDecimal
    }
    class CatalogoDePedidos {
        -modelos Map~String, Pedido~
        +registrar(String, Pedido)
        +criar(String) Pedido
    }
    class PedidosApp {
        +main(String[])$
    }

    Pedido ..|> Prototype
    Pedido "1" *-- "*" ItemPedido
    CatalogoDePedidos o-- "*" Pedido
    PedidosApp ..> CatalogoDePedidos
    PedidosApp ..> Pedido
